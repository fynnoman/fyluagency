generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Singleton settings row (always id = 1)
model Settings {
  id                      Int      @id @default(1)
  businessName            String   @default("Fylu Marketing & Design")
  businessAddress         String   @default("")
  businessEmail           String   @default("")
  businessPhone           String   @default("")
  taxId                   String   @default("")
  iban                    String   @default("")
  bic                     String   @default("")
  bankName                String   @default("")
  logoPath                String?
  vatRate                 Float    @default(19)
  paymentTermsDays        Int      @default(14)
  invoiceNumberPrefix     String   @default("RE")
  invoiceNumberCounter    Int      @default(1)
  invoiceFooter           String   @default("Vielen Dank für die gute Zusammenarbeit.")
  invoiceLayoutPrimary    String   @default("#0B0B0E")
  invoiceLayoutAccent     String   @default("#1F2937")
  ollamaModel             String   @default("llama3.2")
  ollamaBaseUrl           String   @default("http://localhost:11434")
  openAIApiKey            String?
  openAIModel             String   @default("gpt-4o-mini")
  googleAdsCustomerId     String?
  googleAdsRefreshToken   String?
  googleAdsDeveloperToken String?
  updatedAt               DateTime @updatedAt
}

model Customer {
  id            String    @id @default(cuid())
  name          String
  company       String?
  email         String?
  phone         String?
  address       String?
  taxId         String?
  notes         String?
  archivedAt    DateTime?
  lastContactAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 7-Schritte-Prozess-Checkliste. Alle default false, damit bestehende
  // Kunden automatisch bei Schritt 0 starten.
  processOfferAccepted        Boolean @default(false)
  processScopeDefined         Boolean @default(false)
  processPreferencesCollected Boolean @default(false)
  processDownPaymentPaid      Boolean @default(false)
  processProjectCompleted     Boolean @default(false)
  processFinalInvoicePaid     Boolean @default(false)
  processReferenceCollected   Boolean @default(false)

  // Leistungsumfang-Dokument aus Schritt 2 (Pfad im /public/uploads-Bereich).
  scopeDocumentPath       String?
  scopeDocumentFilename   String?
  scopeDocumentUploadedAt DateTime?

  costs            Cost[]
  invoices         Invoice[]
  uploadedInvoices UploadedInvoice[]
  scopeItems       CustomerScopeItem[]
  cashIncomes      CashIncome[]
}

model Lead {
  id               String    @id @default(cuid())
  name             String
  company          String?
  email            String?
  phone            String?
  source           String?
  status           String    @default("new") // new, contacted, meeting, proposal, won, lost
  expectedValue    Float?
  offerDescription String?
  notes            String?
  lastContactAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  emails LeadEmail[]
}

model LeadEmail {
  id                String    @id @default(cuid())
  leadId            String
  direction         String    @default("sent") // sent, received
  subject           String    @default("")
  body              String    @default("")
  summary           String?
  summaryUpdatedAt  DateTime?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Cost {
  id          String    @id @default(cuid())
  customerId  String
  description String
  amount      Float
  frequency   String    @default("once") // once, monthly, yearly
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Invoice {
  id         String    @id @default(cuid())
  customerId String
  number     String    @unique
  date       DateTime  @default(now())
  dueDate    DateTime?
  status     String    @default("draft") // draft, sent, paid, overdue
  subtotal   Float
  vatRate    Float // percent
  vatAmount  Float
  total      Float
  notes      String?
  paidAt     DateTime?
  pdfPath    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    InvoiceItem[]
}

model InvoiceItem {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float  @default(1)
  unitPrice   Float
  total       Float
  order       Int    @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// Customer-uploaded invoices (from third parties or as backup of own)
model UploadedInvoice {
  id             String    @id @default(cuid())
  customerId     String
  filename       String
  path           String
  extractedTotal Float?
  extractedNet   Float?
  extractedVat   Float?
  extractedDate  DateTime?
  extractedRaw   String? // raw extracted text
  status         String    @default("pending") // pending, parsed, manual
  uploadedAt     DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// Einzelne Leistungsposition aus dem Leistungsumfang-Dokument (Schritt 2)
// oder manuell nachgetragen.
model CustomerScopeItem {
  id          String  @id @default(cuid())
  customerId  String
  title       String
  details     String?
  quantity    Float   @default(1)
  unitPrice   Float?
  order       Int     @default(0)
  done        Boolean @default(false)
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// Bareinnahmen (ohne Rechnung) je Kunde, aus der Mac-App importierbar.
model CashIncome {
  id         String   @id @default(cuid())
  customerId String
  details    String
  amount     Float
  date       DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}
